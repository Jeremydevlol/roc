      <ul class="nav-links">
        <li><a href="#" class="active">Home</a></li>
        <li><a href="#what-we-buy">What We Buy</a></li>
        <li><a href="#process">How It Works</a></li>
        <li><a href="#locations">Locations</a></li>
        <li><a href="#about">About Us</a></li>
        <li><a href="#contact">Contact</a></li>
      </ul>
      <a class="btn btn-gold nav-cta" href="#get-offer">Get a Free Offer</a>
    </div>
  </div>
</nav>

<!-- ════════════ HERO ════════════ -->
<section class="hero">
  <div class="hero-left">
    <div class="hero-eyebrow">
      <span class="tag">Trusted Jewelry Buyers · Miami, FL</span>
    </div>
    <h1 class="hero-h1">
      <span class="line-white">We Buy</span>
      <span class="line-gold">Fine Jewelry</span>
      <span class="line-sm">At The Highest Price</span>
    </h1>
    <p class="hero-sub">
      We buy all types of fine jewelry, diamonds, gold, platinum,
      designer pieces and estate collections.<br/>
      <strong>Instant payment. 100% confidential.</strong>
    </p>
    <div class="hero-btns">
      <a class="btn btn-gold" href="#get-offer">Get a Free Offer</a>
      <a class="btn btn-outline" href="#process">Schedule Appointment</a>
    </div>
    <div class="hero-badges">
      <div class="hero-badge">
        <div class="hero-badge-icon">$</div>
        <div class="hero-badge-text"><strong>Top Dollar Paid</strong><span>Best market prices</span></div>
      </div>
      <div class="hero-badge">
        <div class="hero-badge-icon">⚡</div>
        <div class="hero-badge-text"><strong>Immediate Payment</strong><span>Cash or wire transfer</span></div>
      </div>
      <div class="hero-badge">
        <div class="hero-badge-icon">🔒</div>
        <div class="hero-badge-text"><strong>100% Confidential</strong><span>Private & discreet</span></div>
      </div>
      <div class="hero-badge">
        <div class="hero-badge-icon">◆</div>
        <div class="hero-badge-text"><strong>Expert Evaluation</strong><span>GIA certified</span></div>
      </div>
      <div class="hero-badge">
        <div class="hero-badge-icon">✓</div>
        <div class="hero-badge-text"><strong>No Obligation</strong><span>Zero pressure</span></div>
      </div>
    </div>
  </div>
  <div class="hero-right">
    <div class="img-ph hero-img-ph" style="width:100%;height:100%;min-height:600px">
      <svg width="56" height="56" viewBox="0 0 56 56" fill="none"><rect x="4" y="4" width="48" height="48" rx="4" stroke="#C9A84C" stroke-width="1.5"/><circle cx="20" cy="22" r="6" stroke="#C9A84C" stroke-width="1.5"/><path d="M4 40 L16 28 L26 38 L36 26 L52 44" stroke="#C9A84C" stroke-width="1.5" stroke-linejoin="round"/></svg>
      <span>Hero Jewelry Photo</span>
    </div>
    <div class="hero-img-ph overlay"></div>
  </div>
</section>

<!-- ════════════ TRUST STRIP ════════════ -->
<div class="trust-strip">
  <div class="container">
    <div class="trust-strip-inner">
      <div class="trust-item"><div class="trust-icon">$</div><div class="trust-label">Top Dollar<br/>Paid</div></div>
      <div class="trust-item"><div class="trust-icon">⚡</div><div class="trust-label">Immediate<br/>Payment</div></div>
      <div class="trust-item"><div class="trust-icon">🔒</div><div class="trust-label">100% Private<br/>& Confidential</div></div>
      <div class="trust-item"><div class="trust-icon">◆</div><div class="trust-label">Expert<br/>Evaluation</div></div>
      <div class="trust-item"><div class="trust-icon">✓</div><div class="trust-label">No Obligation<br/>No Pressure</div></div>
    </div>
  </div>
</div>

<!-- ════════════ WHO WE HELP ════════════ -->
<section class="who-section">
  <div class="who-grid" style="max-width:1280px;margin:0 auto">
    <div class="who-left reveal">
      <span class="tag">Who We Help</span>
      <h2>We Help <em>Families, Widows</em><br/>&amp; Executors</h2>
      <p>We understand that selling jewelry can be emotional. We treat every client with compassion, respect and complete discretion — whatever your situation may be.</p>
      <div class="who-cats">
        <div class="who-cat"><div class="who-cat-icon">👥</div><div class="who-cat-label">Widows &amp;<br/>Families</div></div>
        <div class="who-cat"><div class="who-cat-icon">📋</div><div class="who-cat-label">Estate &amp; Trust<br/>Settlements</div></div>
        <div class="who-cat"><div class="who-cat-icon">⚖️</div><div class="who-cat-label">Divorce &amp;<br/>Liquidations</div></div>
        <div class="who-cat"><div class="who-cat-icon">💍</div><div class="who-cat-label">Inherited<br/>Collections</div></div>
      </div>
    </div>
    <div class="who-right reveal">
      <div class="img-ph who-right-top">
        <svg width="48" height="48" viewBox="0 0 56 56" fill="none"><rect x="4" y="4" width="48" height="48" rx="4" stroke="#C9A84C" stroke-width="1.5"/><circle cx="20" cy="22" r="6" stroke="#C9A84C" stroke-width="1.5"/><path d="M4 40 L16 28 L26 38 L36 26 L52 44" stroke="#C9A84C" stroke-width="1.5" stroke-linejoin="round"/></svg>
        <span>Lifestyle / Consultation Photo</span>
      </div>
      <div class="who-right-bottom" id="locations">
        <span class="who-cities-label">Serving Clients Nationwide</span>
