        </div>
        <div class="wizard-contact-item">
          <div class="wizard-contact-icon">✉️</div>
          <div class="wizard-contact-text"><strong>rocdiamonds136@gmail.com</strong><span>Email us your photos</span></div>
        </div>
        <div class="wizard-contact-item">
          <div class="wizard-contact-icon">📍</div>
          <div class="wizard-contact-text"><strong>36 NE 1st St. Suite 136, Miami FL 33132</strong><span>ROC Diamonds &amp; Fine Jewelry, LLC</span></div>
        </div>
      </div>
    </div>
    <div class="wizard-right reveal">
      <div id="wizBox"></div>
    </div>
  </div>
</section>

<!-- ════════════ TESTIMONIALS ════════════ -->
<section class="section testi-section" style="padding:80px 0">
  <div class="container">
    <div class="section-header reveal">
      <span class="tag">Client Stories</span>
      <h2>Trusted by <em>Thousands</em><br/>Across the USA</h2>
      <div class="section-divider"></div>
