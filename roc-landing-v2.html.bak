<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1.0"/>
<title>ROC Diamonds — We Buy Fine Jewelry | Miami, FL</title>
<meta name="description" content="We buy diamonds, gold, designer jewelry & estate collections. Top dollar paid. 100% confidential. Same-day offers. Miami FL — serving clients nationwide."/>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;0,900;1,700&family=Montserrat:wght@300;400;500;600;700&display=swap" rel="stylesheet"/>
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{background:#0A0A0A;color:#fff;font-family:'Montserrat',sans-serif;-webkit-font-smoothing:antialiased;overflow-x:hidden}
:root{
  --gold:#C9A84C;
  --gold2:#D4AF5A;
  --gold-dim:rgba(201,168,76,.15);
  --black:#0A0A0A;
  --dark:#111;
  --border:rgba(201,168,76,.18);
  --serif:'Playfair Display',Georgia,serif;
  --sans:'Montserrat',sans-serif;
}
a{text-decoration:none;color:inherit}
img{display:block;max-width:100%}

/* ═══ UTILITY ═══════════════════════════════ */
.container{max-width:1280px;margin:0 auto;padding:0 48px}
@media(max-width:768px){.container{padding:0 24px}}
.gold{color:var(--gold)}
.tag{font-size:10px;font-weight:700;letter-spacing:4px;text-transform:uppercase;color:var(--gold)}

/* image placeholder */
.img-ph{background:#161616;border:1px solid rgba(255,255,255,.06);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12px;color:rgba(255,255,255,.18);overflow:hidden}
.img-ph svg{opacity:.3}
.img-ph span{font-size:10px;letter-spacing:2px;text-transform:uppercase;font-family:var(--sans)}

/* reveal */
.reveal{opacity:0;transform:translateY(20px);transition:opacity .6s ease,transform .6s ease}
.reveal.visible{opacity:1;transform:none}

/* ═══ BUTTONS ═══════════════════════════════ */
.btn{display:inline-flex;align-items:center;justify-content:center;font-family:var(--sans);font-size:11px;font-weight:700;letter-spacing:2.5px;text-transform:uppercase;padding:15px 32px;cursor:pointer;border:none;transition:all .25s;white-space:nowrap}
.btn-gold{background:var(--gold);color:#000}
.btn-gold:hover{background:#D4AF5A;transform:translateY(-1px);box-shadow:0 8px 28px rgba(201,168,76,.3)}
.btn-outline{background:transparent;border:1.5px solid rgba(255,255,255,.4);color:#fff}
.btn-outline:hover{border-color:#fff;background:rgba(255,255,255,.06)}
.btn-outline-gold{background:transparent;border:1.5px solid var(--gold);color:var(--gold)}
.btn-outline-gold:hover{background:var(--gold);color:#000}

/* ═══ NAV ═══════════════════════════════════ */
#nav{position:fixed;top:0;left:0;right:0;z-index:100;background:rgba(10,10,10,.97);border-bottom:1px solid var(--border);backdrop-filter:blur(12px)}
.nav-inner{display:flex;align-items:center;justify-content:space-between;height:70px}
.nav-logo{display:flex;align-items:center;gap:12px}
.nav-logo img{width:48px;height:48px;border-radius:3px}
.nav-logo-text{line-height:1.2}
.nav-logo-name{display:block;font-family:var(--sans);font-size:14px;font-weight:700;letter-spacing:2px;color:#fff;text-transform:uppercase}
.nav-logo-sub{display:block;font-family:var(--sans);font-size:9px;font-weight:500;letter-spacing:3px;color:var(--gold);text-transform:uppercase}
.nav-links{display:none;gap:0;list-style:none}
@media(min-width:1024px){.nav-links{display:flex}}
.nav-links a{font-size:10px;font-weight:600;letter-spacing:2px;text-transform:uppercase;color:rgba(255,255,255,.55);padding:0 16px;height:70px;display:flex;align-items:center;border-bottom:2px solid transparent;transition:all .25s}
.nav-links a:hover,.nav-links a.active{color:#fff;border-bottom-color:var(--gold)}
.nav-cta{display:none}
@media(min-width:768px){.nav-cta{display:block}}

/* ═══ HERO ══════════════════════════════════ */
.hero{min-height:100vh;display:grid;grid-template-columns:1fr 1fr;align-items:stretch;padding-top:70px}
@media(max-width:900px){.hero{grid-template-columns:1fr;min-height:auto}}
.hero-left{display:flex;flex-direction:column;justify-content:center;padding:80px 48px 80px 0;padding-left:calc((100vw - 1280px)/2 + 48px);background:var(--black)}
@media(max-width:1280px){.hero-left{padding-left:48px}}
@media(max-width:768px){.hero-left{padding:60px 24px}}
.hero-eyebrow{display:inline-flex;align-items:center;gap:10px;margin-bottom:24px}
.hero-eyebrow::before{content:'';display:block;width:32px;height:1.5px;background:var(--gold)}
.hero-h1{font-family:var(--serif);font-size:clamp(42px,5.5vw,76px);font-weight:900;line-height:1.0;text-transform:uppercase;margin-bottom:24px;letter-spacing:-1px}
.hero-h1 .line-gold{display:block;color:var(--gold)}
.hero-h1 .line-white{display:block;color:#fff}
.hero-h1 .line-sm{display:block;font-size:clamp(20px,2.5vw,34px);font-weight:700;color:rgba(255,255,255,.7);letter-spacing:2px;margin-top:8px}
.hero-sub{font-size:13px;font-weight:300;line-height:1.85;color:rgba(255,255,255,.5);max-width:440px;margin-bottom:36px}
.hero-sub strong{color:#fff;font-weight:600}
.hero-btns{display:flex;flex-wrap:wrap;gap:14px;margin-bottom:48px}
.hero-badges{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;padding-top:32px;border-top:1px solid var(--border)}
@media(max-width:600px){.hero-badges{grid-template-columns:1fr 1fr}}
.hero-badge{display:flex;align-items:center;gap:10px}
.hero-badge-icon{width:36px;height:36px;border:1px solid var(--border);display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:15px;color:var(--gold)}
.hero-badge-text strong{display:block;font-size:11px;font-weight:700;color:#fff;letter-spacing:.5px}
.hero-badge-text span{font-size:10px;font-weight:300;color:rgba(255,255,255,.4)}
/* Hero image side */
.hero-right{position:relative;overflow:hidden}
.hero-img-ph{width:100%;height:100%;min-height:580px}
@media(max-width:900px){.hero-img-ph{min-height:320px}}
.hero-img-ph .overlay{position:absolute;inset:0;background:linear-gradient(to right,var(--black) 0%,transparent 30%)}

/* ═══ TRUST STRIP ═══════════════════════════ */
.trust-strip{background:var(--dark);border-top:1px solid var(--border);border-bottom:1px solid var(--border)}
.trust-strip-inner{display:grid;grid-template-columns:repeat(5,1fr);gap:0}
@media(max-width:900px){.trust-strip-inner{grid-template-columns:repeat(3,1fr)}}
@media(max-width:500px){.trust-strip-inner{grid-template-columns:1fr 1fr}}
.trust-item{display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:28px 16px;border-right:1px solid var(--border);gap:10px}
.trust-item:last-child{border-right:none}
.trust-icon{font-size:22px;color:var(--gold)}
.trust-label{font-size:11px;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:#fff;line-height:1.3}

/* ═══ SECTION BASE ══════════════════════════ */
.section{padding:96px 0}
.section-header{text-align:center;margin-bottom:64px}
.section-header .tag{display:block;margin-bottom:14px}
.section-header h2{font-family:var(--serif);font-size:clamp(32px,4vw,52px);font-weight:900;text-transform:uppercase;line-height:1.1;letter-spacing:-0.5px}
.section-header h2 em{color:var(--gold);font-style:normal}
.section-divider{width:60px;height:2px;background:var(--gold);margin:20px auto 0}
.section-sub{font-size:13px;font-weight:300;color:rgba(255,255,255,.45);max-width:520px;margin:16px auto 0;line-height:1.8;text-align:center}

/* ═══ WHO WE HELP ═══════════════════════════ */
.who-section{background:#0D0D0D;border-bottom:1px solid var(--border)}
.who-grid{display:grid;grid-template-columns:1fr 1fr;gap:0;align-items:stretch}
@media(max-width:900px){.who-grid{grid-template-columns:1fr}}
.who-left{padding:80px 64px 80px 0;padding-left:calc((100vw - 1280px)/2 + 48px);border-right:1px solid var(--border)}
@media(max-width:1280px){.who-left{padding-left:48px}}
@media(max-width:768px){.who-left{padding:60px 24px;border-right:none;border-bottom:1px solid var(--border)}}
.who-left .tag{display:block;margin-bottom:18px}
.who-left h2{font-family:var(--serif);font-size:clamp(28px,3.5vw,46px);font-weight:900;text-transform:uppercase;line-height:1.1;margin-bottom:20px;letter-spacing:-.5px}
.who-left h2 em{font-style:normal;color:var(--gold)}
.who-left p{font-size:13px;font-weight:300;color:rgba(255,255,255,.5);line-height:1.85;margin-bottom:32px;max-width:420px}
.who-cats{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:36px}
.who-cat{border:1px solid var(--border);padding:20px;display:flex;flex-direction:column;align-items:center;text-align:center;gap:12px;transition:border-color .25s,background .25s;cursor:default}
.who-cat:hover{border-color:var(--gold);background:var(--gold-dim)}
.who-cat-icon{font-size:26px;color:var(--gold)}
.who-cat-label{font-size:10px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:#fff;line-height:1.4}
.who-right{display:flex;flex-direction:column}
.who-right-top{flex:1;min-height:300px}
.who-right-bottom{padding:40px 48px;border-top:1px solid var(--border);background:#111}
@media(max-width:768px){.who-right-bottom{padding:32px 24px}}
.who-cities{display:flex;flex-wrap:wrap;gap:8px 24px}
.who-city{font-size:11px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;color:rgba(255,255,255,.4);transition:color .2s}
.who-city:hover{color:var(--gold)}
.who-cities-label{font-size:10px;font-weight:700;letter-spacing:3px;text-transform:uppercase;color:var(--gold);margin-bottom:14px;display:block}

/* ═══ WHAT WE BUY ═══════════════════════════ */
.buy-section{background:var(--black)}
.buy-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:2px}
@media(max-width:1024px){.buy-grid{grid-template-columns:repeat(3,1fr)}}
@media(max-width:600px){.buy-grid{grid-template-columns:repeat(2,1fr)}}
.buy-card{position:relative;overflow:hidden;cursor:pointer;group:true}
.buy-card-img{aspect-ratio:3/4;width:100%}
.buy-card-overlay{position:absolute;inset:0;background:linear-gradient(to top,rgba(0,0,0,.92) 0%,rgba(0,0,0,.2) 55%,transparent 100%);transition:opacity .3s}
.buy-card:hover .buy-card-overlay{opacity:.7}
.buy-card-content{position:absolute;bottom:0;left:0;right:0;padding:20px 16px;transform:translateY(4px);transition:transform .3s}
.buy-card:hover .buy-card-content{transform:translateY(0)}
.buy-card-label{font-size:11px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:#fff;line-height:1.3}
.buy-card-sub{font-size:10px;font-weight:400;color:var(--gold);margin-top:4px;opacity:0;transform:translateY(6px);transition:all .3s}
.buy-card:hover .buy-card-sub{opacity:1;transform:translateY(0)}
.buy-card-bar{height:2px;background:var(--gold);width:0;transition:width .3s}
.buy-card:hover .buy-card-bar{width:100%}

/* ═══ PROCESS ════════════════════════════════ */
.process-section{background:#0D0D0D;border-top:1px solid var(--border)}
.process-header-wrap{display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center;margin-bottom:64px}
@media(max-width:900px){.process-header-wrap{grid-template-columns:1fr;gap:32px}}
.process-header-wrap h2{font-family:var(--serif);font-size:clamp(30px,4vw,54px);font-weight:900;text-transform:uppercase;line-height:1.05;letter-spacing:-.5px}
.process-header-wrap h2 em{font-style:normal;color:var(--gold)}
.process-header-wrap p{font-size:13px;font-weight:300;color:rgba(255,255,255,.5);line-height:1.85}
.process-steps{display:grid;grid-template-columns:repeat(5,1fr);gap:0;border:1px solid var(--border)}
@media(max-width:900px){.process-steps{grid-template-columns:1fr 1fr}}
@media(max-width:500px){.process-steps{grid-template-columns:1fr}}
.process-step{padding:36px 24px;border-right:1px solid var(--border);position:relative;transition:background .25s}
.process-step:last-child{border-right:none}
.process-step:hover{background:var(--gold-dim)}
.step-number{font-family:var(--serif);font-size:52px;font-weight:900;color:var(--gold);line-height:1;margin-bottom:16px;opacity:.8}
.step-icon{font-size:28px;margin-bottom:14px;color:var(--gold)}
.step-title{font-size:11px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;color:#fff;margin-bottom:10px;line-height:1.4}
.step-body{font-size:12px;font-weight:300;color:rgba(255,255,255,.45);line-height:1.75}
.process-footer{margin-top:0;padding:24px 32px;background:var(--gold);display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:16px}
.process-footer p{font-size:12px;font-weight:600;letter-spacing:1px;color:#000;text-transform:uppercase}
.process-footer a{font-size:11px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:#000;background:#000;color:#fff;padding:12px 24px;transition:background .25s}
.process-footer a:hover{background:#222}

/* ═══ WHY US ══════════════════════════════════ */
.why-section{background:var(--black)}
.why-grid{display:grid;grid-template-columns:1fr 1fr;gap:0;align-items:stretch}
@media(max-width:900px){.why-grid{grid-template-columns:1fr}}
.why-left{border-right:1px solid var(--border)}
@media(max-width:900px){.why-left{border-right:none;border-bottom:1px solid var(--border)}}
.why-left-img{min-height:400px}
.why-left-quote{padding:40px 48px;background:#111;border-top:1px solid var(--border)}
@media(max-width:768px){.why-left-quote{padding:32px 24px}}
.why-left-quote blockquote{font-family:var(--serif);font-size:22px;font-style:italic;color:var(--gold);line-height:1.5;margin-bottom:12px}
.why-left-quote cite{font-size:11px;font-weight:300;color:rgba(255,255,255,.35);font-style:normal}
.why-right{padding:72px 64px;padding-right:calc((100vw - 1280px)/2 + 48px)}
@media(max-width:1280px){.why-right{padding-right:48px}}
@media(max-width:768px){.why-right{padding:48px 24px}}
.why-right .tag{display:block;margin-bottom:14px}
.why-right h2{font-family:var(--serif);font-size:clamp(28px,3.5vw,46px);font-weight:900;text-transform:uppercase;line-height:1.1;margin-bottom:40px;letter-spacing:-.5px}
.why-right h2 em{font-style:normal;color:var(--gold)}
.why-items{display:flex;flex-direction:column;gap:0}
.why-item{display:flex;gap:20px;padding:24px 0;border-bottom:1px solid var(--border);align-items:flex-start}
.why-item:first-child{border-top:1px solid var(--border)}
.why-item-icon{width:44px;height:44px;border:1px solid var(--border);display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:18px;color:var(--gold);transition:all .25s}
.why-item:hover .why-item-icon{border-color:var(--gold);background:var(--gold-dim)}
.why-item-text h4{font-size:13px;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:#fff;margin-bottom:6px}
.why-item-text p{font-size:12px;font-weight:300;color:rgba(255,255,255,.45);line-height:1.75}

/* ═══ WIZARD ══════════════════════════════════ */
.wizard-section{background:#111;border-top:1px solid var(--border);border-bottom:1px solid var(--border)}
.wizard-grid{display:grid;grid-template-columns:1fr 1fr;gap:0;align-items:stretch}
@media(max-width:900px){.wizard-grid{grid-template-columns:1fr}}
.wizard-left{padding:72px 64px 72px 0;padding-left:calc((100vw - 1280px)/2 + 48px);border-right:1px solid var(--border)}
@media(max-width:1280px){.wizard-left{padding-left:48px}}
@media(max-width:900px){.wizard-left{border-right:none;border-bottom:1px solid var(--border)}}
@media(max-width:768px){.wizard-left{padding:48px 24px}}
.wizard-left .tag{display:block;margin-bottom:14px}
.wizard-left h2{font-family:var(--serif);font-size:clamp(28px,3.5vw,46px);font-weight:900;text-transform:uppercase;line-height:1.05;margin-bottom:20px;letter-spacing:-.5px}
.wizard-left h2 em{font-style:normal;color:var(--gold)}
.wizard-left p{font-size:13px;font-weight:300;color:rgba(255,255,255,.45);line-height:1.85;margin-bottom:32px;max-width:400px}
.wizard-benefits{list-style:none;margin-bottom:40px}
.wizard-benefits li{display:flex;align-items:center;gap:12px;font-size:12px;font-weight:400;color:rgba(255,255,255,.6);padding:10px 0;border-bottom:1px solid rgba(255,255,255,.04)}
.wizard-benefits li::before{content:'◆';color:var(--gold);font-size:8px;flex-shrink:0}
.wizard-contact-row{display:flex;flex-direction:column;gap:12px;margin-top:36px;padding-top:32px;border-top:1px solid var(--border)}
.wizard-contact-item{display:flex;align-items:center;gap:14px}
.wizard-contact-icon{width:38px;height:38px;border:1px solid var(--border);display:flex;align-items:center;justify-content:center;font-size:14px;color:var(--gold);flex-shrink:0}
.wizard-contact-text strong{display:block;font-size:13px;font-weight:700;color:#fff;letter-spacing:.5px}
.wizard-contact-text span{font-size:11px;font-weight:300;color:rgba(255,255,255,.4)}
/* Wizard box */
.wizard-right{padding:64px 48px;padding-right:calc((100vw - 1280px)/2 + 48px)}
@media(max-width:1280px){.wizard-right{padding-right:48px}}
@media(max-width:768px){.wizard-right{padding:48px 24px}}
#wizBox{background:var(--black);border-top:3px solid var(--gold)}
.wiz-prog-head{display:flex;justify-content:space-between;padding:20px 28px 14px;border-bottom:1px solid var(--border)}
.wiz-step-lbl{font-size:10px;font-weight:700;letter-spacing:3px;text-transform:uppercase;color:var(--gold)}
.wiz-prog-bar-wrap{height:2px;background:rgba(255,255,255,.06)}
.wiz-prog-bar{height:100%;background:var(--gold);transition:width .5s cubic-bezier(.4,0,.2,1)}
.wiz-inner{padding:28px}
.wiz-q-title{font-family:var(--serif);font-size:clamp(20px,2.2vw,28px);font-weight:700;color:#fff;margin-bottom:6px;line-height:1.25}
.wiz-q-sub{font-size:12px;font-weight:300;color:rgba(255,255,255,.35);margin-bottom:24px;line-height:1.6}
/* Cards */
.wiz-cards{display:grid;grid-template-columns:1fr 1fr;gap:8px}
@media(max-width:500px){.wiz-cards{grid-template-columns:1fr}}
.wiz-cards.cols-1{grid-template-columns:1fr}
.wiz-card{display:flex;align-items:center;gap:12px;padding:13px 15px;border:1px solid rgba(255,255,255,.08);cursor:pointer;transition:all .2s;background:none;color:inherit;text-align:left;width:100%}
.wiz-card:hover{border-color:rgba(201,168,76,.4);background:rgba(201,168,76,.05)}
.wiz-card.sel{border-color:var(--gold);background:rgba(201,168,76,.08)}
.wiz-card-i{font-size:18px;color:rgba(255,255,255,.2);transition:color .2s;flex-shrink:0}
.wiz-card.sel .wiz-card-i{color:var(--gold)}
.wiz-card-l{font-family:var(--serif);font-size:15px;font-weight:700;color:rgba(255,255,255,.55);transition:color .2s;display:block}
.wiz-card.sel .wiz-card-l{color:#fff}
.wiz-card-s{font-size:10px;font-weight:300;color:rgba(255,255,255,.25);display:block;margin-top:1px}
.wiz-chk{margin-left:auto;width:16px;height:16px;background:var(--gold);display:none;align-items:center;justify-content:center;flex-shrink:0}
.wiz-card.sel .wiz-chk{display:flex}
/* Pills */
.wiz-pills{display:flex;flex-wrap:wrap;gap:8px}
.wiz-pill{font-size:11px;font-weight:500;padding:9px 16px;border:1px solid rgba(255,255,255,.1);color:rgba(255,255,255,.45);cursor:pointer;background:none;transition:all .2s;letter-spacing:.5px}
.wiz-pill:hover{border-color:rgba(201,168,76,.4);color:rgba(255,255,255,.7)}
.wiz-pill.sel{border-color:var(--gold);color:var(--gold);background:rgba(201,168,76,.07)}
/* Fields */
.wiz-fields{display:flex;flex-direction:column;gap:14px}
.wiz-row{display:grid;grid-template-columns:1fr 1fr;gap:14px}
@media(max-width:480px){.wiz-row{grid-template-columns:1fr}}
.wiz-field label{display:block;font-size:10px;letter-spacing:2px;text-transform:uppercase;color:rgba(255,255,255,.35);margin-bottom:7px;font-weight:600}
.wiz-field input,.wiz-field select{width:100%;background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.1);color:rgba(255,255,255,.85);font-family:var(--sans);font-size:13px;font-weight:300;padding:13px 15px;outline:none;transition:border .25s}
.wiz-field input::placeholder{color:rgba(255,255,255,.2)}
.wiz-field input:focus,.wiz-field select:focus{border-color:var(--gold)}
.wiz-field select option{background:#111}
/* Nav */
.wiz-nav{display:flex;align-items:center;justify-content:space-between;margin-top:24px;padding-top:20px;border-top:1px solid rgba(255,255,255,.05)}
.wiz-back-btn{font-size:10px;letter-spacing:2px;text-transform:uppercase;color:rgba(255,255,255,.25);background:none;border:none;cursor:pointer;transition:color .25s;padding:0;font-family:var(--sans);font-weight:500}
.wiz-back-btn:hover{color:rgba(255,255,255,.6)}
.wiz-next-btn,.wiz-submit-btn{font-family:var(--sans);font-size:11px;font-weight:700;letter-spacing:2px;text-transform:uppercase;background:var(--gold);color:#000;padding:13px 26px;border:none;cursor:pointer;transition:background .25s}
.wiz-next-btn:hover,.wiz-submit-btn:hover{background:#D4AF5A}
.wiz-submit-btn{width:100%;margin-top:6px;padding:15px}
.wiz-next-btn:disabled,.wiz-submit-btn:disabled{opacity:.3;cursor:not-allowed}
/* Success */
.wiz-success{padding:40px 28px;text-align:center}
.wiz-success-ring{width:64px;height:64px;border:1.5px solid var(--gold);display:flex;align-items:center;justify-content:center;margin:0 auto 20px;border-radius:50%}
.wiz-success h3{font-family:var(--serif);font-size:32px;font-weight:900;text-transform:uppercase;color:#fff;margin-bottom:10px}
.wiz-success h3 em{font-style:normal;color:var(--gold)}
.wiz-success p{font-size:12px;font-weight:300;color:rgba(255,255,255,.45);max-width:300px;margin:0 auto 28px;line-height:1.8}
.wiz-success-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
.wiz-suc-badge{padding:14px 10px;border:1px solid var(--border);text-align:center}
.wiz-suc-badge .icon{color:var(--gold);font-size:18px;margin-bottom:6px}
.wiz-suc-badge span{font-size:10px;font-weight:500;color:rgba(255,255,255,.45);display:block;line-height:1.4;letter-spacing:.5px}

/* ═══ TESTIMONIALS ═══════════════════════════ */
.testi-section{background:#0D0D0D;border-top:1px solid var(--border)}
.testi-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:2px}
@media(max-width:900px){.testi-grid{grid-template-columns:1fr}}
.testi-card{padding:40px;background:#0D0D0D;transition:background .25s;position:relative;overflow:hidden}
.testi-card:hover{background:#141414}
.testi-card::before{content:'"';position:absolute;top:10px;left:24px;font-family:var(--serif);font-size:80px;font-weight:900;color:rgba(201,168,76,.06);line-height:1;pointer-events:none}
.testi-stars{color:var(--gold);font-size:13px;letter-spacing:3px;margin-bottom:16px}
.testi-text{font-family:var(--serif);font-size:16px;font-style:italic;font-weight:400;line-height:1.75;color:rgba(255,255,255,.65);margin-bottom:24px;position:relative;z-index:1}
.testi-author{display:flex;align-items:center;gap:12px;border-top:1px solid var(--border);padding-top:20px}
.testi-av{width:40px;height:40px;background:rgba(201,168,76,.12);border:1px solid var(--border);display:flex;align-items:center;justify-content:center;font-family:var(--serif);font-size:15px;color:var(--gold);flex-shrink:0;font-weight:700}
.testi-name{font-size:13px;font-weight:600;color:#fff}
.testi-role{font-size:10px;font-weight:300;color:rgba(255,255,255,.3);margin-top:2px}

/* ═══ FOOTER ══════════════════════════════════ */
footer{background:#000;border-top:1px solid var(--border)}
.footer-top{background:var(--gold);padding:20px 0}
.footer-top-inner{display:flex;align-items:center;justify-content:center;gap:10px;flex-wrap:wrap}
.footer-top-inner p{font-size:12px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:#000}
.footer-top-inner a{font-size:11px;font-weight:700;letter-spacing:2px;text-transform:uppercase;background:#000;color:#fff;padding:10px 22px;transition:background .25s}
.footer-top-inner a:hover{background:#222}
.footer-main{padding:64px 0 40px}
.footer-grid{display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:48px}
@media(max-width:1024px){.footer-grid{grid-template-columns:1fr 1fr}}
@media(max-width:600px){.footer-grid{grid-template-columns:1fr}}
.footer-brand .logo-row{display:flex;align-items:center;gap:12px;margin-bottom:16px}
.footer-brand .logo-row img{width:42px;height:42px;border-radius:2px}
.footer-brand-name{font-size:13px;font-weight:700;letter-spacing:3px;text-transform:uppercase;color:#fff}
.footer-brand-sub{font-size:9px;letter-spacing:3px;text-transform:uppercase;color:var(--gold);font-weight:500}
.footer-brand p{font-size:12px;font-weight:300;color:rgba(255,255,255,.3);line-height:1.85;max-width:280px;margin-bottom:20px}
.footer-contact-grid{display:flex;flex-direction:column;gap:12px;margin-top:4px}
.footer-contact-item{display:flex;align-items:center;gap:12px}
.footer-contact-icon{width:32px;height:32px;border:1px solid var(--border);display:flex;align-items:center;justify-content:center;color:var(--gold);font-size:13px;flex-shrink:0}
.footer-contact-text strong{display:block;font-size:12px;font-weight:600;color:#fff;letter-spacing:.5px}
.footer-contact-text span{font-size:10px;font-weight:300;color:rgba(255,255,255,.3)}
.footer-col-title{font-size:10px;font-weight:700;letter-spacing:3px;text-transform:uppercase;color:var(--gold);margin-bottom:20px;padding-bottom:12px;border-bottom:1px solid var(--border)}
.footer-col ul{list-style:none}
.footer-col li{margin-bottom:10px}
.footer-col a{font-size:12px;font-weight:300;color:rgba(255,255,255,.35);transition:color .25s}
.footer-col a:hover{color:var(--gold)}
.footer-bottom{border-top:1px solid var(--border);padding:20px 0}
.footer-bottom-inner{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px}
.footer-copy{font-size:11px;font-weight:300;color:rgba(255,255,255,.2)}
.footer-links{display:flex;gap:20px}
.footer-links a{font-size:11px;font-weight:300;color:rgba(255,255,255,.2);transition:color .25s}
.footer-links a:hover{color:var(--gold)}

/* ═══ RESPONSIVE ═════════════════════════════ */
@media(max-width:768px){
  .section{padding:64px 0}
  .process-steps{border:none}
  .process-step{border-right:none;border-bottom:1px solid var(--border)}
}
</style>
</head>
<body>

<!-- ════════════ NAV ════════════ -->
<nav id="nav">
  <div class="container">
    <div class="nav-inner">
      <a class="nav-logo" href="#">
        <img src="output-onlinepngtools.png" alt="ROC Diamonds"/>
        <div class="nav-logo-text">
          <span class="nav-logo-name">ROC Diamonds</span>
          <span class="nav-logo-sub">Buyers of Fine Jewelry</span>
        </div>
