<script>
/* ── Wizard ─────────────────────────────── */
const STEPS=[
  {id:"situation",type:"cards",multi:false,
   title:"What best describes your situation?",sub:"This helps us personalize your experience.",
   opts:[
    {v:"widow",l:"Widow / Widower",s:"Settling a spouse's estate",i:"🕊"},
    {v:"executor",l:"Estate Executor",s:"Managing an estate collection",i:"📋"},
    {v:"divorce",l:"Divorce Settlement",s:"Dividing or liquidating assets",i:"⚖"},
    {v:"inherited",l:"Inherited Jewelry",s:"Pieces passed down to me",i:"💎"},
    {v:"downsizing",l:"Downsizing",s:"Simplifying &amp; freeing up value",i:"🏠"},
    {v:"collection",l:"Selling a Collection",s:"Multiple pieces to sell",i:"✦"},
   ]},
  {id:"cat",type:"cards",multi:true,
   title:"What would you like to sell?",sub:"Select all that apply.",
   opts:[
    {v:"diamonds",l:"Diamond Jewelry",s:"Rings, earrings, pendants",i:"◆"},
    {v:"gold",l:"Gold & Platinum",s:"Any karat, any condition",i:"⬡"},
    {v:"watches",l:"Luxury Watches",s:"Rolex, Patek, Cartier…",i:"◎"},
    {v:"designer",l:"Designer Jewelry",s:"Cartier, Tiffany, Van Cleef…",i:"✦"},
    {v:"antique",l:"Antique & Vintage",s:"Art Deco, Victorian, Edwardian",i:"❖"},
    {v:"estate",l:"Full Estate Collection",s:"Multiple pieces or entire estate",i:"⬢"},
   ]},
  {id:"diamonds_detail",type:"pills",
   title:"Diamond size range?",sub:"Helps us prepare a more accurate offer.",
   showIf:a=>(a.cat||[]).includes("diamonds"),
   opts:[{v:"u1",l:"Under 1 ct"},{v:"1_2",l:"1–2 cts"},{v:"2_5",l:"2–5 cts"},{v:"5p",l:"5+ cts"},{v:"multi",l:"Multiple"},{v:"ns",l:"Not sure"}]},
  {id:"watches_detail",type:"pills",
   title:"Watch brand(s)?",sub:"Designer brands command premium prices.",
   showIf:a=>(a.cat||[]).includes("watches"),
   opts:[{v:"rolex",l:"Rolex"},{v:"patek",l:"Patek Philippe"},{v:"cartier",l:"Cartier"},{v:"ap",l:"Audemars Piguet"},{v:"iwc",l:"IWC"},{v:"other",l:"Other brand"}]},
  {id:"timeline",type:"cards",multi:false,
   title:"How soon are you looking to sell?",sub:"We offer same-day evaluations.",
   opts:[
    {v:"asap",l:"As Soon As Possible",s:"I need to sell quickly",i:"⚡"},
    {v:"1_3m",l:"Within 1–3 Months",s:"Planning ahead",i:"◷"},
    {v:"exp",l:"Just Exploring",s:"Want to understand value",i:"◉"},
   ]},
  {id:"value",type:"cards",multi:false,
   title:"Approximate total value?",sub:"Rough estimate — no pressure.",
   opts:[
    {v:"u2500",l:"Under $2,500",i:"◇"},
    {v:"2500_10k",l:"$2,500 – $10,000",i:"◈"},
    {v:"10_50k",l:"$10,000 – $50,000",i:"◆"},
    {v:"50kp",l:"$50,000+",s:"Eligible for house call",i:"❋"},
    {v:"ns",l:"Not Sure",s:"That's what we're here for",i:"?"},
   ]},
  {id:"contact",type:"input",title:"Where should we send your offer?",sub:"We'll reach out within 1 business hour."},
  {id:"done",type:"success"},
];

const ans={cat:[]};
const contact={};
let idx=0;

function vis(){return STEPS.filter(s=>!s.showIf||s.showIf(ans));}
function cur(){return vis()[idx];}
function total(){return vis().length;}
function pct(){return Math.max((idx/(total()-2))*100,4);}

function render(){
  const s=cur();
  const box=document.getElementById('wizBox');
  if(s.type==='success'){
    box.innerHTML=`<div class="wiz-success">
      <div class="wiz-success-ring"><svg width="28" height="28" viewBox="0 0 28 28" fill="none"><polyline points="5,14 11,20 23,8" stroke="#C9A84C" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
      <h3>Request <em>Received!</em></h3>
      <p>Our estate jewelry specialist will contact you within 1 business hour to confirm your appointment.</p>
      <div class="wiz-success-grid">
        <div class="wiz-suc-badge"><div class="icon">◆</div><span>Expert evaluation prepared</span></div>
        <div class="wiz-suc-badge"><div class="icon">⚡</div><span>Confirmed within 1 hour</span></div>
        <div class="wiz-suc-badge"><div class="icon">🔒</div><span>100% confidential</span></div>
      </div>
    </div>`;
    return;
  }

  let body='';
  if(s.type==='cards'){
    const two=s.opts.length>3;
    body=`<div class="wiz-cards${s.opts.length<=3?' cols-1':''}">`+s.opts.map(o=>{
      const sel=s.multi?(ans.cat||[]).includes(o.v):ans[s.id]===o.v;
      return `<button class="wiz-card${sel?' sel':''}" data-v="${o.v}" data-multi="${s.multi?1:0}">
        <span class="wiz-card-i">${o.i||'◆'}</span>
        <span><span class="wiz-card-l">${o.l}</span>${o.s?`<span class="wiz-card-s">${o.s}</span>`:''}</span>
        <span class="wiz-chk"><svg width="10" height="10" viewBox="0 0 10 10" fill="none"><polyline points="2,5 4,7 8,3" stroke="#000" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
      </button>`;
    }).join('')+'</div>';
  } else if(s.type==='pills'){
    const arr=ans[s.id]||[];
    body=`<div class="wiz-pills">`+s.opts.map(o=>`<button class="wiz-pill${arr.includes(o.v)?' sel':''}" data-v="${o.v}">${o.l}</button>`).join('')+'</div>';
  } else if(s.type==='input'){
    body=`<div class="wiz-fields">
      <div class="wiz-row">
        <div class="wiz-field"><label>First Name *</label><input id="wf_fn" type="text" placeholder="Jane" value="${contact.fn||''}"/></div>
        <div class="wiz-field"><label>Last Name *</label><input id="wf_ln" type="text" placeholder="Smith" value="${contact.ln||''}"/></div>
      </div>
      <div class="wiz-field"><label>Email Address *</label><input id="wf_em" type="email" placeholder="jane@email.com" value="${contact.em||''}"/></div>
      <div class="wiz-field"><label>Phone Number *</label><input id="wf_ph" type="tel" placeholder="+1 (305) 000-0000" value="${contact.ph||''}"/></div>
      <div class="wiz-field"><label>Preferred Appointment Type</label>
        <select id="wf_ap"><option value="">Select…</option>
          <option${contact.ap==='gallery'?' selected':''} value="gallery">In-person at our gallery</option>
          <option${contact.ap==='phone'?' selected':''} value="phone">Phone / Video consultation</option>
          <option${contact.ap==='house'?' selected':''} value="house">House call (large collections)</option>
        </select></div>
    </div>`;
  }

  const isInput=s.type==='input';
  const canNext=s.id==='cat'?ans.cat.length>0:true;
  const canSubmit=isInput&&contact.fn&&contact.ln&&contact.em&&contact.ph;
  const showContinue=(s.id==='cat')||(s.type==='pills')||(s.id==='situation'&&false);

  box.innerHTML=`
    <div>
      <div class="wiz-prog-head">
        <span class="wiz-step-lbl">Step ${idx+1} of ${total()-1}</span>
        <span style="font-size:10px;color:rgba(255,255,255,.25);font-family:var(--sans);font-weight:500;text-transform:uppercase;letter-spacing:2px">Free Evaluation</span>
      </div>
      <div class="wiz-prog-bar-wrap"><div class="wiz-prog-bar" style="width:${pct()}%"></div></div>
      <div class="wiz-inner">
        <h3 class="wiz-q-title">${s.title}</h3>
        ${s.sub?`<p class="wiz-q-sub">${s.sub}</p>`:''}
        ${body}
        ${isInput?`<button class="wiz-submit-btn" id="wiz_sub" ${canSubmit?'':'disabled'}>Submit &amp; Get My Offer →</button>`:''}
        <div class="wiz-nav">
          ${idx>0?`<button class="wiz-back-btn" id="wiz_back">← Back</button>`:'<div></div>'}
          ${showContinue?`<button class="wiz-next-btn" id="wiz_nxt" ${canNext?'':'disabled'}>Continue →</button>`:'<div></div>'}
        </div>
      </div>
    </div>`;

  // Events
  box.querySelectorAll('.wiz-card').forEach(b=>{
    b.addEventListener('click',function(){
      const v=this.dataset.v,multi=this.dataset.multi==='1';
      if(multi){const i=ans.cat.indexOf(v);i>-1?ans.cat.splice(i,1):ans.cat.push(v);}
      else{ans[s.id]=v;setTimeout(()=>{idx++;render();},250);return;}
      render();
    });
  });
  box.querySelectorAll('.wiz-pill').forEach(b=>{
    b.addEventListener('click',function(){
      const v=this.dataset.v,arr=ans[s.id]||[];
      const i=arr.indexOf(v);i>-1?arr.splice(i,1):arr.push(v);
      ans[s.id]=arr;render();
    });
  });
  document.getElementById('wiz_nxt')?.addEventListener('click',()=>{idx++;render();});
  document.getElementById('wiz_back')?.addEventListener('click',()=>{idx--;render();});
  document.getElementById('wiz_sub')?.addEventListener('click',()=>{idx++;render();});
  if(isInput){
    [{id:'fn',k:'fn'},{id:'ln',k:'ln'},{id:'em',k:'em'},{id:'ph',k:'ph'},{id:'ap',k:'ap'}].forEach(({id,k})=>{
      document.getElementById('wf_'+id)?.addEventListener('input',function(){contact[k]=this.value;
        const btn=document.getElementById('wiz_sub');
        if(btn)btn.disabled=!(contact.fn&&contact.ln&&contact.em&&contact.ph);
      });
    });
  }
}

render();

/* ── Scroll Reveal ── */
const obs=new IntersectionObserver(entries=>{
  entries.forEach((e,i)=>{if(e.isIntersecting){setTimeout(()=>e.target.classList.add('visible'),i*70);obs.unobserve(e.target);}});
},{threshold:.07,rootMargin:'0px 0px -30px 0px'});
document.querySelectorAll('.reveal').forEach(el=>obs.observe(el));
</script>
</body>
</html>
